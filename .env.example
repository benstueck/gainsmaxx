# Copy to .env.local and fill in from your Supabase project.

# Client SDK credentials — Supabase Dashboard -> Project Settings -> API Keys.
# New Supabase projects issue a "publishable" key (sb_publishable_...), which
# replaces the legacy anon JWT key. Both are browser-safe; use whichever your
# project shows. (If yours only shows a legacy anon key, put it here instead.)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Database connection strings — Supabase Dashboard -> Project Settings ->
# Database -> Connection string. Needed for Drizzle migrations / queries
# (NOT shown in the API quickstart). Use the "Connect" button to reveal them.
# App runtime uses the POOLED connection (Transaction pooler, port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations use the DIRECT connection (Session pooler, port 5432).
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
